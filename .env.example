# Copy to .env and fill in.  .env is git-ignored.

# --- ngrok (required to expose the site publicly) -----------------------
# Get a token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# A reserved domain from https://dashboard.ngrok.com/domains
# e.g. gaurav-portfolio.ngrok.app  (no https://)
NGROK_DOMAIN=

# --- GitHub (optional) -------------------------------------------------
# Only raises API rate limits for the build-time fetch. A classic PAT with
# NO scopes (public read) is enough. Leave blank to run unauthenticated.
GITHUB_TOKEN=
